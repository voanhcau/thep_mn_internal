  <Script><![CDATA[public void ActiveReport_PageStart()
{
		if(((Label)rpt.Sections["pageHeader"].Controls["Ma_So_Thue"]).Text != "")
		 { 
		 		Label  lblMa_So_Thue = (Label)rpt.Sections["pageHeader"].Controls["Ma_So_Thue"];
		 		
		 		for(int i = 0; i<= 13; i++)
		 			{
				 		if(lblMa_So_Thue.Text.Length >i)
				 				((Label)rpt.Sections["pageHeader"].Controls["L"+ (i + 1) ]).Text = 	lblMa_So_Thue.Text.Substring(i, 1);
				 		else
				 				((Label)rpt.Sections["pageHeader"].Controls["L"+ (i + 1) ]).Text ="";
				 	}
			 }

		 

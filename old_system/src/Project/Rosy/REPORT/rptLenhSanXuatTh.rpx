      <Control Type="AR.Label" Name="Label4" Tag="So_Ct" Left="3015.36" Top="440.64" Width="2187.361" Height="345.5999" Caption="So_Ct" HyperLink="" Style="font-size: 11pt; font-weight: normal; ddo-char-set: 1; font-family: Tahoma" />
      <Control Type="AR.Field" Name="TextBox16" Left="547.2" Top="861.1202" Width="14761.44" Height="567.36" Text="- Thép thành phẩm nội địa sản xuất theo Quy định tiêu chuẩn sản phẩm nội bộ của Phòng QLCL (QĐ-QLCL-01 ngày 20/11/2018), Barem sản xuất thép thanh vằn theo Quyết định 518/QĐ-TMN ngày 17/04/2019." Style="ddo-char-set: 0; font-size: 11.25pt; font-family: Tahoma; white-space: inherit; text-align: left; font-weight: normal; text-decoration: none" />
      <Control Type="AR.Field" Name="TextBox17" Left="547.2" Top="1518.48" Width="14761.44" Height="293.0398" Text="- Thép thành phẩm xuất khẩu sản xuất theo biên bản thỏa thuận với Chip mong ngày" Style="ddo-char-set: 0; font-size: 11.25pt; font-family: Tahoma; white-space: inherit; text-align: left; font-weight: normal; text-decoration: none" />
      <Control Type="AR.Field" Name="TextBox18" Left="547.2" Top="1916.64" Width="14761.44" Height="357.12" Text="- Phôi dùng sản xuất size D25 có trọng lượng 2.105 kg/cây; phôi dùng sản xuất size D32 có trọng lượng 2.060 kg/cây. " Style="ddo-char-set: 0; font-size: 11.25pt; font-family: Tahoma; white-space: inherit; text-align: left; font-weight: normal; text-decoration: none" />
      <Control Type="AR.Field" Name="TextBox19" Left="547.2" Top="2334.24" Width="14761.44" Height="866.88" Text="- Tùy theo tình hình sản xuất thực tế, PXSX có thể điều chỉnh linh hoạt sản lượng các nhóm phôi đáp ứng đủ cho sản xuất thép thành phẩm, duy trì cân đối tồn phôi thời điểm đảm bảo theo tỷ lệ: Nhóm I: 40% (trong đó phôi CB240T 50% ), Nhóm II: 10%, Nhóm III: 50%. Đề nghị PXSX nạp nóng tối đa theo Lệnh sản xuất ban hành." Style="ddo-char-set: 0; font-size: 11.25pt; font-family: Tahoma; white-space: inherit; text-align: left; font-weight: normal; text-decoration: none" />
      <Control Type="AR.Field" Name="TextBox20" Left="547.2" Top="3291.12" Width="14761.44" Height="326.16" Text="- Yêu cầu các đơn vị thực hiện nghiêm túc Lệnh sản xuất trên." Style="ddo-char-set: 0; font-size: 11.25pt; font-family: Tahoma; white-space: inherit; text-align: left; font-weight: normal; text-decoration: none" />
      <Control Type="AR.Field" Name="TextBox22" Left="547.2" Top="3707.28" Width="14761.44" Height="326.16" Text="* Đánh giá tác động ảnh hưởng:" Style="ddo-char-set: 1; font-size: 11.25pt; font-family: Tahoma; white-space: inherit; text-align: left; font-weight: bold; text-decoration: none" />

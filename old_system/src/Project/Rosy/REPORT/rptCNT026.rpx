      <Control Type="AR.Label" Name="Label36" Tag="" Left="792.0004" Top="4560.479" Width="15318.72" Height="288" Caption="3/Số tiền các bên phải thanh toán theo (1) hoặc (2) được thực hiện bằng chuyển khoản qua tài khoản ngân hàng;" Style="ddo-char-set: 1; text-align: left; font-weight: normal; font-size: 12pt; font-family: Times New Roman" />
      <Control Type="AR.Label" Name="Label33" Tag="" Left="792.0004" Top="3602.16" Width="15318.72" Height="288" Caption="Hai bên cùng xác nhận tiền lãi phát sinh khi thanh toán tiền hàng giữa Bên A và Bên B theo số liệu dưới đây." Style="ddo-char-set: 1; text-align: left; font-weight: normal; font-size: 12pt; font-family: Times New Roman" />

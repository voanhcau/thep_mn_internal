<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iwmn_sync_system_list" model="ir.ui.view">
        <field name="name">iwmn.sync.system.list</field>
        <field name="model">iwmn.sync.system</field>
        <field name="arch" type="xml">
            <list string="Đồng bộ master-data" default_order="last_sync_at desc, id desc">
                <field name="name"/>
                <field name="master_entity"/>
                <field name="target_model"/>
                <field name="state" widget="badge"/>
                <field name="fetched_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="skipped_count"/>
                <field name="last_sync_at"/>
            </list>
        </field>
    </record>

    <record id="view_iwmn_sync_system_form" model="ir.ui.view">
        <field name="name">iwmn.sync.system.form</field>
        <field name="model">iwmn.sync.system</field>
        <field name="arch" type="xml">
            <form string="Đồng bộ master-data">
                <header>
                    <button name="action_sync"
                            type="object"
                            string="Đồng bộ"
                            class="oe_highlight"
                            invisible="state == 'running'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Đối tượng đồng bộ">
                            <field name="master_entity"/>
                            <field name="target_model" readonly="1"/>
                            <field name="page_size"/>
                        </group>
                        <group string="Kết quả gần nhất">
                            <field name="last_sync_at"/>
                            <field name="last_duration_seconds"/>
                            <field name="fetched_count"/>
                            <field name="created_count"/>
                            <field name="updated_count"/>
                            <field name="skipped_count"/>
                        </group>
                    </group>
                    <group string="Lỗi gần nhất" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_iwmn_sync_system_search" model="ir.ui.view">
        <field name="name">iwmn.sync.system.search</field>
        <field name="model">iwmn.sync.system</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="master_entity"/>
                <field name="state"/>
                <filter name="failed" string="Thất bại" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_iwmn_sync_system" model="ir.actions.act_window">
        <field name="name">Đồng bộ master-data</field>
        <field name="res_model">iwmn.sync.system</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_iwmn_sync_system_search"/>
    </record>

    <menuitem id="menu_iwmn_sync_system"
              name="Đồng bộ hệ thống"
              parent="iwmn_base.menu_iwmn_base_root"
              action="action_iwmn_sync_system"
              groups="base.group_system"
              sequence="95"/>
</odoo>

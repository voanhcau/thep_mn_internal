<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_iwmn_sync" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.iwmn.sync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Đồng bộ master-data" name="iwmn_sync_system" groups="base.group_system">
                    <block title="Kết nối IntegrationHub" name="iwmn_sync_api_settings">
                        <setting string="API đồng bộ MSSQL"
                                 help="OAuth 2.0 Client Credentials dùng bởi Odoo server; client cần scope master.read.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="iwmn_sync_api_url" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_sync_api_url" placeholder="http://localhost:9119"/>
                                </div>
                                <div class="row mt16">
                                    <label for="iwmn_sync_api_client_id" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_sync_api_client_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="iwmn_sync_api_client_secret" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_sync_api_client_secret" password="True"/>
                                </div>
                                <div class="row mt16">
                                    <label for="iwmn_sync_api_timeout" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_sync_api_timeout"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>


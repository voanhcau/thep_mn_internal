<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_credit_dashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.credit.dashboard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Dashboard khách hàng" name="iwmn_customer_dashboard" groups="base.group_system">
                    <block title="Kết nối IntegrationHub" name="iwmn_credit_api_settings">
                        <setting string="API hạn mức tín dụng"
                                 help="Thông tin OAuth 2.0 Client Credentials dùng để gọi API từ server Odoo.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="iwmn_credit_api_url" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_credit_api_url" placeholder="https://api.company.vn"/>
                                </div>
                                <div class="row mt16">
                                    <label for="iwmn_credit_api_client_id" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_credit_api_client_id"/>
                                </div>
                                <div class="row mt16">
                                    <label for="iwmn_credit_api_client_secret" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_credit_api_client_secret" password="True"/>
                                </div>
                                <div class="row mt16">
                                    <label for="iwmn_credit_api_business_unit" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_credit_api_business_unit"/>
                                </div>
                                <div class="row mt16">
                                    <label for="iwmn_credit_api_timeout" class="col-lg-3 o_light_label"/>
                                    <field name="iwmn_credit_api_timeout"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>


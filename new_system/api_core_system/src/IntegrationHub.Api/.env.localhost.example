# Copy this file to .env for direct Visual Studio Development runs.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:9119

TokenIssuer__Enabled=true
TokenIssuer__Issuer=http://localhost:9119
TokenIssuer__Audience=integration-api
TokenIssuer__KeyId=integration-local-2026-01
TokenIssuer__PrivateKeyPath=.secrets/local-token-private.pem
TokenIssuer__PublicKeyPath=.secrets/local-token-public.pem
TokenIssuer__AccessTokenLifetimeMinutes=30

TokenIssuer__Clients__0__ClientId=odoo-local
TokenIssuer__Clients__0__ClientSecret=LOCAL_ONLY_odoo_secret_9119_change_me
TokenIssuer__Clients__0__AllowedScopes__0=finance.read
TokenIssuer__Clients__0__AllowedScopes__1=master.read
TokenIssuer__Clients__0__AllowedScopes__2=odoo.call
TokenIssuer__Clients__0__AllowedScopes__3=orders.write

LegacyDatabase__ConnectionString="Server=YOUR_SQL_SERVER,1433;Database=YOUR_DATABASE;User ID=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True"

Odoo__Enabled=true
Odoo__BaseUrl=http://localhost:8069
Odoo__Database=YOUR_ODOO_DATABASE
Odoo__ApiKey=YOUR_ODOO_SERVICE_ACCOUNT_API_KEY
Odoo__TimeoutSeconds=30

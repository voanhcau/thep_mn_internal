JWT_AUTHORITY=https://identity.example.com/realms/integration
JWT_AUDIENCE=integration-api
LEGACY_DB_CONNECTION=Server=192.168.1.20,1433;Database=LEGACY_ERP;User ID=integration_api;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
ODOO_ENABLED=true
ODOO_BASE_URL=https://odoo.company.vn
ODOO_DATABASE=production_database
ODOO_API_KEY=STORE_THE_ODOO_SERVICE_ACCOUNT_API_KEY_OUTSIDE_GIT
ODOO_TIMEOUT_SECONDS=30

# Local token issuer (optional; keep disabled when an external Identity Provider is used).
TOKEN_ISSUER_ENABLED=false
TOKEN_ISSUER=https://api.company.vn
TOKEN_AUDIENCE=integration-api
TOKEN_KEY_ID=integration-signing-2026-01
TOKEN_PRIVATE_KEY_PATH=/run/secrets/token-signing-private.pem
TOKEN_PUBLIC_KEY_PATH=/run/secrets/token-signing-public.pem
TOKEN_CLIENT_ID=odoo-integration
TOKEN_CLIENT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AND_STORE_IT_OUTSIDE_GIT
